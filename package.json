{
  "name": "yuvexpay-plugins",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Community plugin manifests for the YuvexPay app store",
  "license": "MIT",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "validate:schema": "ajv validate -s schema/manifest.schema.json -d \"plugins/*.json\" --spec=draft2020 --strict=false --all-errors",
    "publish:prod": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "ajv-cli": "^5.0.0"
  }
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["* 0-5 * * 3"],
  "automergeSchedule": ["* 0-5 * * 3"],
  "prConcurrentLimit": 2,
  "prHourlyLimit": 0,
  "rangeStrategy": "bump",
  "platformAutomerge": false,
  "lockFileMaintenance": { "enabled": true, "automerge": true, "schedule": ["* 0-5 * * 3"] },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major",
      "automerge": true
    },
    { "matchUpdateTypes": ["major"], "automerge": false },
    {
      "matchDatasources": ["docker", "node-version"],
      "matchPackageNames": ["node"],
      "allowedVersions": "<25",
      "groupName": "node"
    }
  ]
}
